# Local development only. Copy to .env; never use these credentials in production.
POSTGRES_PASSWORD=kip_dev_only
POSTGRES_PORT=5432
QDRANT_PORT=6333
KIP_DATABASE_URL=postgresql+psycopg://kip:kip_dev_only@127.0.0.1:5432/kip
KIP_STORAGE_ROOT=data/objects
KIP_LEASE_SECONDS=300
KIP_PARSE_TIMEOUT_SECONDS=120
# Linux only: address space the parser child may add on top of its startup footprint.
KIP_PARSE_MEMORY_MB=1024
# Vector store and embeddings (Phase 3). Use the same port as QDRANT_PORT.
KIP_QDRANT_URL=http://127.0.0.1:6333
# KIP_QDRANT_API_KEY=
KIP_QDRANT_TIMEOUT_SECONDS=30
KIP_EMBED_BATCH_SIZE=32
KIP_EMBED_DEVICE=cpu
KIP_SEARCH_OVERFETCH=4
# Hybrid retrieval and reranking (Phase 4)
KIP_SEARCH_MAX_CANDIDATES=200
KIP_HYBRID_CANDIDATES=50
KIP_RRF_K=60
KIP_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
KIP_RERANK_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
KIP_RERANK_MAX_LENGTH=512
KIP_RERANK_CANDIDATES=30
# Grounded answers (Phase 5). Start Ollama with: docker compose --profile llm up -d ollama
OLLAMA_PORT=11434
KIP_OLLAMA_URL=http://127.0.0.1:11434
KIP_LLM_MODEL=llama3.2:3b
# Pin the weights: copy the digest from `ollama list` or GET /api/tags.
# KIP_LLM_MODEL_DIGEST=
KIP_LLM_CONTEXT_WINDOW=4096
KIP_LLM_MAX_ANSWER_TOKENS=512
KIP_LLM_TEMPERATURE=0
KIP_LLM_SEED=7
KIP_ANSWER_TOP_K=12
KIP_ANSWER_BUDGET_TOKENS=1500
KIP_ANSWER_RERANK=true
KIP_AUTHORITY_POLICY=current=include,unknown=include,superseded=demote,withdrawn=demote
KIP_SUFFICIENCY_MIN_COVERAGE=0.7
KIP_SUFFICIENCY_MIN_RERANK=-2.0
KIP_ANSWER_STORE_QUESTION=true
