# Local development only. Copy to .env; never use these credentials in production.
POSTGRES_PASSWORD=kip_dev_only
POSTGRES_PORT=5432
QDRANT_PORT=6333
KIP_DATABASE_URL=postgresql+psycopg://kip:kip_dev_only@127.0.0.1:5432/kip
KIP_STORAGE_ROOT=data/objects
KIP_LEASE_SECONDS=300
KIP_PARSE_TIMEOUT_SECONDS=120
# Linux only: address space the parser child may add on top of its startup footprint.
KIP_PARSE_MEMORY_MB=1024
# Vector store and embeddings (Phase 3). Use the same port as QDRANT_PORT.
KIP_QDRANT_URL=http://127.0.0.1:6333
# KIP_QDRANT_API_KEY=
KIP_QDRANT_TIMEOUT_SECONDS=30
KIP_EMBED_BATCH_SIZE=32
KIP_EMBED_DEVICE=cpu
KIP_SEARCH_OVERFETCH=4
